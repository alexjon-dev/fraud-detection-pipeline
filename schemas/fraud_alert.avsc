{
  "type": "record",
  "name": "FraudAlert",
  "namespace": "com.fraud.detection.events",
  "doc": "Schema for fraud alerts generated by the detection pipeline",
  "fields": [
    { "name": "alert_id", "type": "string", "doc": "Unique identifier for the alert" },
    { "name": "transaction_id", "type": "string", "doc": "Associated transaction ID" },
    { "name": "customer_id", "type": "string", "doc": "Associated customer ID" },
    { "name": "risk_score", "type": "double", "doc": "Calculated fraud risk score (0.0 to 1.0)" },
    { "name": "risk_level", "type": "string", "doc": "Risk classification (e.g., LOW, MEDIUM, HIGH, CRITICAL)" },
    { "name": "alert_reasons", "type": {"type": "array", "items": "string"}, "doc": "List of reasons for the alert" },
    { "name": "status", "type": "string", "doc": "Status of the alert investigation (e.g., OPEN, INVESTIGATING, RESOLVED, FALSE_POSITIVE)", "default": "OPEN" },
    { "name": "event_timestamp", "type": "long", "doc": "Epoch timestamp of the alert generation, in milliseconds", "logicalType": "timestamp-millis" }
  ]
}
